# ===============================
# Shared app configuration
# ===============================
JWT_SECRET=your_super_secret_key

# ===============================
# Express app (InternProject1)
# ===============================
HOST=127.0.0.1
PORT=3000

# ===============================
# Database config used by server
# ===============================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=InternProjectDB
DB_USER=root
DB_PASSWORD=your_db_password

# ===============================
# gRPC server config
# ===============================
GRPC_PORT=127.0.0.1:50051
GRPC_CLIENT_URL=http://localhost:50051

# Optional
NODE_ENV=development
